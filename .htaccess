# Clean URLs on Apache hosting (cPanel and similar): /music serves
# music.html. GitHub Pages and Netlify do this on their own, and Vercel
# reads vercel.json; everywhere else this file is simply ignored.
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
